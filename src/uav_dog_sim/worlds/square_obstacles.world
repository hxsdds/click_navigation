<?xml version="1.0"?>
<sdf version="1.8">
  <world name="square_obstacles">
    <physics name="physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.65 0.72 0.80 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -0.1 0 0 0</pose>
          <geometry><box><size>22 22 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.1 0 0 0</pose>
          <geometry><box><size>22 22 0.2</size></box></geometry>
          <material>
            <ambient>0.38 0.40 0.38 1</ambient>
            <diffuse>0.38 0.40 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="square_walls">
      <static>true</static>
      <link name="link">
        <collision name="north_collision">
          <pose>0 10.2 1.25 0 0 0</pose>
          <geometry><box><size>20.8 0.4 2.5</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 10.2 1.25 0 0 0</pose>
          <geometry><box><size>20.8 0.4 2.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
        <collision name="south_collision">
          <pose>0 -10.2 1.25 0 0 0</pose>
          <geometry><box><size>20.8 0.4 2.5</size></box></geometry>
        </collision>
        <visual name="south_visual">
          <pose>0 -10.2 1.25 0 0 0</pose>
          <geometry><box><size>20.8 0.4 2.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
        <collision name="east_collision">
          <pose>10.2 0 1.25 0 0 0</pose>
          <geometry><box><size>0.4 20.8 2.5</size></box></geometry>
        </collision>
        <visual name="east_visual">
          <pose>10.2 0 1.25 0 0 0</pose>
          <geometry><box><size>0.4 20.8 2.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
        <collision name="west_collision">
          <pose>-10.2 0 1.25 0 0 0</pose>
          <geometry><box><size>0.4 20.8 2.5</size></box></geometry>
        </collision>
        <visual name="west_visual">
          <pose>-10.2 0 1.25 0 0 0</pose>
          <geometry><box><size>0.4 20.8 2.5</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_obstacle">
      <static>true</static>
      <pose>0 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.8</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.8</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.75 0.25 0.12 1</ambient><diffuse>0.75 0.25 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="rectangular_obstacle">
      <static>true</static>
      <pose>4 2 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.5 1.5 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.5 1.5 2.0</size></box></geometry>
          <material><ambient>0.12 0.35 0.75 1</ambient><diffuse>0.12 0.35 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cube_obstacle">
      <static>true</static>
      <pose>-4 3 1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 2 2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2 2 2</size></box></geometry>
          <material><ambient>0.18 0.68 0.25 1</ambient><diffuse>0.18 0.68 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
