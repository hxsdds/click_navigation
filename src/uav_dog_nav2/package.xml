<?xml version="1.0"?>
<package format="3">
  <name>uav_dog_nav2</name>
  <version>0.1.0</version>
  <description>Static 3D map browser navigation for Go2 and PX4 SITL. Uses a custom planner and NavigateToPose interface, not a full Nav2 stack.</description>
  <maintainer email="3308620733@qq.com">hxsdds</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>control_input_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
